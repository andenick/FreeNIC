# FreeNIC environment configuration — copy to .env and edit.
# Every variable is optional; the defaults shown make the pipeline run
# entirely inside the repository checkout. See pipeline/REFRESH.md
# ("Configuration") for the authoritative table.

# Warehouse export directory: parquet/, SHA256SUMS.txt, PROVENANCE.csv
FREENIC_OUTPUTS=Outputs

# Raw acquisition cache (downloaded FFIEC/FDIC/NCUA bulk files)
FREENIC_INPUTS=Inputs

# Fallback root searched for bundled inputs when FREENIC_INPUTS has none
DATA_ROOT=data

# Warehouse DuckDB file (defaults to $FREENIC_OUTPUTS/freenic.duckdb)
# FREENIC_WAREHOUSE=Outputs/freenic.duckdb

# Runnable site app, used by release-tools/build_slice.py
FREENIC_SITE_DIR=../site

# Local checkout of the public bank-data-dictionary repository, used to
# re-pin the dict.* tables during a quarterly refresh
# BANK_DATA_DICTIONARY_REPO=/path/to/bank-data-dictionary

# FRED API key, required only for the H.8 disaggregated release (phase 27b).
# Request one free at https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=

# Alternative to FRED_API_KEY: path to a keys file holding it
# FREENIC_KEYS_ENV=keys.env
